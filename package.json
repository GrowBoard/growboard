    "jest-transform-stub": "^2.0.0",
    "lodash": "^4.17.21",
    "prettier": "3.2.5",
    "react-test-renderer": "^18.3.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.2"
  }
