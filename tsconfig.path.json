{
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@assets": ["src/assets"],
      "@components": ["src/components"],
      "@localization": ["src/localization"],
      "@provider": ["src/provider"],
      "@router": ["src/router"],
      "@router/*": ["src/router/*"],
      "@screens": ["src/screens"],
      "@screens/*": ["src/screens/*"],
      "@services": ["src/services"],
      "@services/*": ["src/services/*"],
      "@service": ["src/service"],
      "@service/*": ["src/service/*"],
      "@store": ["src/store/index"],
      "@store/slice": ["src/store/slice"],
      "@selectors": ["src/store/selectors"]
    }
  }
}
